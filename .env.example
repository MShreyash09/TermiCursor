# Copy to .env for local development. Never commit .env (it is gitignored).
# The desktop app reads these from Settings instead.

# Optional cloud LLM (sends prompts and code to Groq)
LLM_PROVIDER=ollama
GROQ_API_KEY=

# Research/eval scripts only (judge_evaluation.py)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
