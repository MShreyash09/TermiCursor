# Copy to .env for local development. Never commit .env (it is gitignored).
# The desktop app reads these from Settings instead.

# Optional cloud LLM (sends prompts and code to Groq)
LLM_PROVIDER=ollama
GROQ_API_KEY=

# Optional Langfuse tracing of agent LLM calls (latency, tokens, model).
# Off unless both keys are set. Requires `pip install langfuse` (not in requirements.txt).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Host: the SDK's own name is LANGFUSE_HOST; llm_client.py remaps this to it.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set to 1 to also trace prompt and completion TEXT. This ships slices of the
# user's source code to the Langfuse host. Default (unset) records metadata only.
LANGFUSE_TRACE_PROMPTS=
