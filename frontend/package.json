{
  "name": "termicursor-ui",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5180 && electron .\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:backend": "cd .. && python -m PyInstaller --noconfirm termicursor-backend.spec",
    "package": "npm run build:backend && npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.termicursor.app",
    "productName": "Termicursor",
    "publish": [
      {
        "provider": "github",
        "owner": "MShreyash09",
        "repo": "TermiCursor"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "../dist/termicursor-backend",
        "to": "termicursor-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.12",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "framer-motion": "^14.4.0",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.60.0",
    "monaco-editor": "^0.57.0",
    "music-metadata": "^12.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.7",
    "xterm": "^5.3.0"
  },
  "overrides": {
    "dompurify": ">=3.4.17",
    "shell-quote": ">=1.11.0"
  }
}
