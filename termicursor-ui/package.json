{
  "name": "termicursor-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.termicursor.app",
    "productName": "Termicursor",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis"]
    },
    "extraResources": [
      {
        "from": "../dist/termicursor-backend",
        "to": "termicursor-backend",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2"
  }
}
